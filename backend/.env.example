# Runtime. The EC2 deployment runs one production process on loopback port 8787.
NODE_ENV=production
PORT=8787

# Must be exactly "free" or "paid". Only the matching database URL is used.
MODE=free

# Neon PostgreSQL connection strings. Keep sslmode=require in production.
DATABASE_URL_FREE=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_PAID=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Base64-encoded 32-byte key used to encrypt provider keys.
# Generate with: openssl rand -base64 32
MASTER_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# Razorpay Orders API and webhook verification credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Secret used to sign access and refresh JWTs.
# Generate with: openssl rand -base64 48
JWT_SECRET=<random-jwt-signing-secret>

# Minimum accepted desktop client build.
MIN_BUILD_VERSION=1.0.0

# Structured log verbosity: debug | info | warn | error. Default: info.
# The request logger emits one JSON line per API call at this level (info
# for 2xx/3xx, warn for 4xx, error for 5xx). On EC2 these stdout lines are
# shipped to CloudWatch Logs by the CloudWatch agent, so the full API-call
# trail lives in CloudWatch (set a retention policy there) and uses no Neon
# storage. Bodies, headers, query strings, and secrets are never logged.
LOG_LEVEL=info

# Resend transactional email configuration.
RESEND_API_KEY=
EMAIL_FROM=UpNod <noreply@referconnect.in>

# Vercel applications permitted by CORS and used in email links.
WEB_APP_URL=https://upnod.referconnect.in
ADMIN_DASHBOARD_URL=https://admin.referconnect.in
WEB_APP_BASE_URL=https://upnod.referconnect.in

# Google OAuth ("Sign in with Google"). Public OAuth 2.0 *Web application*
# client ID from Google Cloud Console (APIs & Services > Credentials). Used as
# the audience when verifying Google ID tokens on POST /auth/google. No client
# secret is required for the ID-token verification flow. The web app must use
# this same value as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
