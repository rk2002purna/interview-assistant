# Base URL of the backend API. Defaults to "/api" (proxied) when unset.
VITE_API_BASE_URL=/api

# Google OAuth ("Sign in with Google") — the public OAuth 2.0 Web application
# client ID from Google Cloud Console (APIs & Services > Credentials).
# Add your web app origin(s) to the client's "Authorized JavaScript origins"
# (e.g. https://upnod.referconnect.in and http://localhost:5173).
# The backend must be configured with the SAME value as GOOGLE_CLIENT_ID.
# When unset, the "Continue with Google" button is hidden.
VITE_GOOGLE_CLIENT_ID=
